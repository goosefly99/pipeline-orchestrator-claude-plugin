# pipeline-orchestrator environment variables (spec §10.2).
# Copy to .env (gitignored) or set in your shell / the .mcp.json env block
# before starting the server. All are OPTIONAL; defaults shown below.
# Config is read lazily on first tool call — never at import/handshake.

# --- second_brain COLD vector leg (kb_search) ---
# Master gate + handshake key. UNSET => the additive vector leg is DISABLED and
# pipeline_kb_search is byte-identical to BM25-only (vector_status="disabled").
SECOND_BRAIN_INDEX_PATH=

# venv python that runs `second_brain.cli` (subprocess; never imported in-process).
# Default if unset: /opt/second-brain/bin/python
SECOND_BRAIN_PYTHON=

# Optional handshake assertion: when set, status.embedder_version must match
# (e.g. sentence-transformers/all-MiniLM-L6-v2@hf-fp32). Unset => assertion skipped.
SECOND_BRAIN_EMBEDDER_VERSION=

# Advisory passthrough flag. Default true; any case-insensitive "false" disables.
SECOND_BRAIN_ENABLED=true

# Vault/index path-derivation root (mirrors how second_brain derives /data/vault).
# Default if unset: /data
AGENTIC_OS_DATA=

# --- web search (pipeline_web_search) ---
# "brave" selects the Brave API (requires BRAVE_API_KEY); unset => DuckDuckGo.
PIPELINE_SEARCH_API=

# Required only when PIPELINE_SEARCH_API=brave.
BRAVE_API_KEY=

# --- legacy output dirs (cc_*/synth_* overview/spec persistence fallback) ---
# Override the legacy overview output dir (else config/default).
CONCEPTS_OUTPUT_DIR=

# Override the legacy spec output dir (else config/default).
SYNTH_OUTPUT_DIR=

# --- resource caps (opt-in memory/size guards) ---
# Cap on TOTAL normalized items held in the shared in-RAM collection store
# (cc_*/synth_* load_collection). When exceeded, whole oldest-loaded
# collections are FIFO-evicted (the just-loaded one always survives).
# Unset / <= 0 => unlimited (legacy behavior).
PIPELINE_MCP_STORE_MAX_ITEMS=

# Cap on fetched web-page content (pipeline_web_search fetch mode). The HTTP
# body read stops at the cap and stored item content is truncated to it, with
# "truncated": true recorded in the item's metadata. Default 2097152 (2 MiB);
# <= 0 disables the cap.
PIPELINE_MCP_FETCH_MAX_BYTES=

# Per-run FIFO cap on in-RAM KB query-log entries (pipeline_kb_search /
# pipeline_kb_sql_query logging). Oldest entries are evicted from both the
# run store and the phase index. Unset / <= 0 => unlimited (legacy behavior).
PIPELINE_MCP_QUERY_LOG_MAX_ENTRIES=
